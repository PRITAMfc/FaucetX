# Backend
PORT=3001
NODE_ENV=development

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Upstash Redis (REST API)
UPSTASH_REDIS_REST_URL=https://your-project.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# Upstash Redis (Standard protocol for BullMQ)
UPSTASH_REDIS_URL=rediss://default:your-token@your-project.upstash.io:6379

# Mistral AI
MISTRAL_API_KEY=your-mistral-api-key-here

# Faucet Processor Config
FAUCET_CIRCUIT_BREAKER_THRESHOLD=5
FAUCET_CIRCUIT_BREAKER_COOLDOWN=30000
FAUCET_RATE_LIMIT_WINDOW=60000
FAUCET_RATE_LIMIT_MAX=3
FAUCET_DEDUP_TTL=300
FAUCET_LOCK_TTL=45000
FAUCET_CONCURRENCY=10
FAUCET_RATE_LIMITER_MAX=100
FAUCET_JOB_ATTEMPTS=5

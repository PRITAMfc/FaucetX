{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "faucetx-prom" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "faucetx-prom" },
          "expr": "max(faucetx_process_uptime_seconds{job=~\"faucetx-.*\"})",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "title": "Backend Uptime",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "faucetx-prom" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 300 },
              { "color": "red", "value": 500 }
            ]
          },
          "unit": "decmbytes"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "faucetx-prom" },
          "expr": "max(faucetx_process_memory_rss_mb{job=~\"faucetx-.*\"})",
          "legendFormat": "RSS MB",
          "refId": "A"
        }
      ],
      "title": "Process Memory (RSS)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "faucetx-prom" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "reqps"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "5xx" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 3,
      "options": { "legend": { "calcs": ["mean"], "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "faucetx-prom" },
          "expr": "sum(rate(faucetx_http_responses_total{job=~\"faucetx-.*\"}[5m])) by (status)",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "title": "HTTP Response Rate by Status",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "faucetx-prom" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "continuous-GrYlRd" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 4,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "faucetx-prom" },
          "expr": "avg by (route) (faucetx_http_latency_p95_ms{job=~\"faucetx-.*\"})",
          "legendFormat": "p95 {{route}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "faucetx-prom" },
          "expr": "avg by (route) (faucetx_http_latency_avg_ms{job=~\"faucetx-.*\"})",
          "legendFormat": "avg {{route}}",
          "refId": "B"
        }
      ],
      "title": "Request Latency per Route",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "faucetx-prom" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 40,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "id": 5,
      "options": { "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "faucetx-prom" },
          "expr": "sum(increase(faucetx_http_requests_total{job=~\"faucetx-.*\"}[1h])) by (method)",
          "legendFormat": "{{method}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "faucetx-prom" },
          "expr": "sum(increase(faucetx_http_errors_total{job=~\"faucetx-.*\"}[1h])) or vector(0)",
          "legendFormat": "5xx errors",
          "refId": "B"
        }
      ],
      "title": "Requests & Errors (per hour)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "faucetx-prom" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 30,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "id": 6,
      "options": { "legend": { "calcs": ["mean"], "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "faucetx-prom" },
          "expr": "faucetx_cache_hit{job=~\"faucetx-.*\"} / clamp_min(faucetx_cache_hit{job=~\"faucetx-.*\"} + faucetx_cache_miss{job=~\"faucetx-.*\"}, 1)",
          "legendFormat": "cache hit ratio",
          "refId": "A"
        }
      ],
      "title": "Cache Hit Ratio",
      "type": "timeseries"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["faucetx", "stellar"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "FaucetX Monitoring",
  "uid": "faucetx-monitoring",
  "version": 1,
  "weekStart": ""
}
